{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "presensi-wajah",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presensi_db",
      "database_id": "a3ebdab4-bb1a-44ef-9b10-b2122b07ae82"
    }
  ]
}
